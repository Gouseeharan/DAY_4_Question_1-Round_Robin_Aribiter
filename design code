module robin( input clk, reset, [3:0]req, output reg [3:0]grant);
always @(posedge clk ) begin
  if ( reset ) 
  grant <= 4'b0000;
  else
  casex ( req )
  4'b0000: grant <=  4'b0000;
  4'b0001: grant <=  4'b0001;
  4'b001x: grant <=  4'b0010;
  4'b01xx: grant <=  4'b0100;
  4'b1xxx: grant <=  4'b1000;
  endcase
  end
  endmodule
