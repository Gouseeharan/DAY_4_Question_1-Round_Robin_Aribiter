module robin (
    input clk,
    input reset,
    input [3:0] req,
    output reg [3:0] grant
);

reg [1:0] priority;

always @(posedge clk) begin
    if (reset) begin
        grant <= 4'b0000;
        priority <= 2'b00;
    end
    else begin
        grant <= 4'b0000;

        case (priority)

            2'd0: begin
                if (req[0]) begin
                    grant <= 4'b0001;
                    priority <= 2'd1;
                end
                else if (req[1]) begin
                    grant <= 4'b0010;
                    priority <= 2'd2;
                end
                else if (req[2]) begin
                    grant <= 4'b0100;
                    priority <= 2'd3;
                end
                else if (req[3]) begin
                    grant <= 4'b1000;
                    priority <= 2'd0;
                end
            end

            2'd1: begin
                if (req[1]) begin
                    grant <= 4'b0010;
                    priority <= 2'd2;
                end
                else if (req[2]) begin
                    grant <= 4'b0100;
                    priority <= 2'd3;
                end
                else if (req[3]) begin
                    grant <= 4'b1000;
                    priority <= 2'd0;
                end
                else if (req[0]) begin
                    grant <= 4'b0001;
                    priority <= 2'd1;
                end
            end

            2'd2: begin
                if (req[2]) begin
                    grant <= 4'b0100;
                    priority <= 2'd3;
                end
                else if (req[3]) begin
                    grant <= 4'b1000;
                    priority <= 2'd0;
                end
                else if (req[0]) begin
                    grant <= 4'b0001;
                    priority <= 2'd1;
                end
                else if (req[1]) begin
                    grant <= 4'b0010;
                    priority <= 2'd2;
                end
            end

            2'd3: begin
                if (req[3]) begin
                    grant <= 4'b1000;
                    priority <= 2'd0;
                end
                else if (req[0]) begin
                    grant <= 4'b0001;
                    priority <= 2'd1;
                end
                else if (req[1]) begin
                    grant <= 4'b0010;
                    priority <= 2'd2;
                end
                else if (req[2]) begin
                    grant <= 4'b0100;
                    priority <= 2'd3;
                end
            end

        endcase
    end
end

endmodule
